{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "scripts/**/*.ts", "forge.config.ts", "vite.*.config.ts"],
  "exclude": ["dist", ".vite", "test/e2e/**"]
}
