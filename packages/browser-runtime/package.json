{
  "name": "@oh-my-pi/pi-browser-runtime",
  "version": "17.2.12",
  "description": "Neutral Playwright browser service and page automation for Workspace V1",
  "type": "module",
  "homepage": "https://omp.sh",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/browser-runtime"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@oh-my-pi/pi-wire": "catalog:",
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": ["src", "test", "CHANGELOG.md"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  }
}
