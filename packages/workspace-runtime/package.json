{
  "type": "module",
  "name": "@oh-my-pi/pi-workspace-runtime",
  "version": "17.2.12",
  "description": "Pure reducer and application contracts for the Workspace V1 runtime",
  "homepage": "https://omp.sh",
  "author": "Can Boluk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/workspace-runtime"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "branchlight": "src/cli.ts"
  },
  "scripts": {
    "build": "bun scripts/build-runtime.ts",
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "bun test",
    "test:contracts": "bun test test/workspace-runtime.test.ts",
    "test:authority": "bun test test/workspace-runtime-authority.test.ts",
    "test:terminals": "bun test test/workspace-runtime-terminals.test.ts",
    "test:services": "bun test test/workspace-runtime-services.test.ts",
    "test:browser": "bun test test/workspace-runtime-browser.test.ts",
    "test:adapters": "bun test test/workspace-runtime-adapters.test.ts",
    "test:mcp": "bun test test/workspace-runtime-mcp.test.ts",
    "test:git": "bun test test/workspace-runtime-git-ssh.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@oh-my-pi/omptype": "catalog:",
    "@oh-my-pi/pi-browser-runtime": "catalog:",
    "@oh-my-pi/pi-natives": "catalog:",
    "@oh-my-pi/pi-utils": "catalog:",
    "@oh-my-pi/pi-wire": "catalog:",
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": ["src", "test", "CHANGELOG.md"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  }
}
